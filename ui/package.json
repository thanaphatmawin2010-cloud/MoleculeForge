{
  "name": "@moleculeforge/ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "dev:lite": "vite --mode lite --host 127.0.0.1 --port 5174 --strictPort",
    "build:lite": "tsc -b && vite build --mode lite",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:lite": "vite preview --mode lite --outDir dist-lite --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "i18n:check": "node scripts/check-i18n.mjs",
    "bridge": "node scripts/dev-bridge.mjs",
    "e2e": "playwright test --trace off",
    "e2e:lite": "playwright test -c playwright.lite.config.ts --trace off"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/ibm-plex-sans-thai": "^5.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@rdkit/rdkit": "2026.9.2",
    "@tauri-apps/api": "^2.1.0",
    "cmdk": "^1.0.0",
    "dompurify": "^3.2.0",
    "framer-motion": "^11.11.0",
    "i18next": "^27.2.6",
    "i18next-icu": "^2.3.0",
    "intl-messageformat": "^10.7.0",
    "lucide-react": "^0.460.0",
    "marked": "^15.0.0",
    "openchemlib": "9.26.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^18.0.3",
    "three": "^0.170.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "^9.15.0",
    "@formatjs/icu-messageformat-parser": "2.11.4",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.1",
    "ws": "^8.18.0"
  }
}
