<?xml version="1.0" encoding="utf-8"?>
<!-- Backups and device transfer carry the saved library (the WebView's IndexedDB) and settings. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
