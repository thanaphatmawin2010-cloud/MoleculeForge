{
  "$comment": "Pinned third-party engines bundled with MoleculeForge. fetch_engines.py downloads and verifies these; nothing is fetched at runtime.",
  "micromamba": {
    "version": "2.10.0",
    "license": "BSD-3-Clause",
    "source": "https://conda.anaconda.org/conda-forge/{subdir}/micromamba-2.10.0-0.tar.bz2"
  },
  "conda_pins": {
    "$comment": "Applied to every conda-built engine. conda-forge defaults to Intel MKL on Windows (about 700 MB per engine, which would push the Windows installers past their 2 GB limit); Linux and macOS already resolve to OpenBLAS.",
    "specs": [
      "libblas=*=*openblas"
    ]
  },
  "xtb": {
    "version": "6.8.0",
    "license": "LGPL-3.0-or-later",
    "homepage": "https://github.com/grimme-lab/xtb",
    "conda_spec": "xtb=6.8.0",
    "channel": "conda-forge"
  },
  "mopac": {
    "version": "23.2.5",
    "license": "Apache-2.0",
    "homepage": "https://github.com/openmopac/mopac",
    "conda_spec": "mopac=23.2.5",
    "channel": "conda-forge"
  },
  "vina": {
    "version": "1.2.7",
    "license": "Apache-2.0",
    "homepage": "https://github.com/ccsb-scripps/AutoDock-Vina",
    "assets": {
      "linux-x64": "https://github.com/ccsb-scripps/AutoDock-Vina/releases/download/v1.2.7/vina_1.2.7_linux_x86_64",
      "macos-x64": "https://github.com/ccsb-scripps/AutoDock-Vina/releases/download/v1.2.7/vina_1.2.7_mac_x86_64",
      "macos-arm64": "https://github.com/ccsb-scripps/AutoDock-Vina/releases/download/v1.2.7/vina_1.2.7_mac_aarch64",
      "windows-x64": "https://github.com/ccsb-scripps/AutoDock-Vina/releases/download/v1.2.7/vina_1.2.7_win.exe"
    }
  },
  "llama_cpp": {
    "tag": "b12650",
    "license": "MIT",
    "repo": "https://github.com/ggml-org/llama.cpp",
    "cmake_common": [
      "-DCMAKE_BUILD_TYPE=Release",
      "-DLLAMA_CURL=OFF",
      "-DLLAMA_BUILD_TESTS=OFF",
      "-DLLAMA_BUILD_EXAMPLES=OFF",
      "-DLLAMA_BUILD_SERVER=ON",
      "-DGGML_BACKEND_DL=ON",
      "-DGGML_CPU_ALL_VARIANTS=ON",
      "-DGGML_NATIVE=OFF",
      "-DBUILD_SHARED_LIBS=ON"
    ],
    "cmake_platform": {
      "$comment": "Added after cmake_common (later -D values win). Windows and macOS follow llama.cpp's own CI and release builds: clang with Ninja on Windows (MSVC is not what upstream tests the CPU variants with), and on macOS one CPU back-end linked directly, with an @loader_path rpath so the libraries are found next to llama-server. {src} is the llama.cpp source directory.",
      "linux-x64": [
        "-DGGML_VULKAN=ON"
      ],
      "windows-x64": [
        "-G",
        "Ninja Multi-Config",
        "-DCMAKE_TOOLCHAIN_FILE={src}/cmake/x64-windows-llvm.cmake",
        "-DGGML_VULKAN=ON",
        "-DGGML_OPENMP=OFF"
      ],
      "macos-arm64": [
        "-DGGML_BACKEND_DL=OFF",
        "-DGGML_CPU_ALL_VARIANTS=OFF",
        "-DGGML_METAL=ON",
        "-DGGML_METAL_EMBED_LIBRARY=ON",
        "-DCMAKE_INSTALL_RPATH=@loader_path",
        "-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON"
      ],
      "macos-x64": [
        "-DGGML_BACKEND_DL=OFF",
        "-DGGML_CPU_ALL_VARIANTS=OFF",
        "-DGGML_METAL=OFF",
        "-DGGML_AVX=ON",
        "-DGGML_AVX2=ON",
        "-DGGML_FMA=ON",
        "-DGGML_F16C=ON",
        "-DGGML_BMI2=ON",
        "-DCMAKE_INSTALL_RPATH=@loader_path",
        "-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON"
      ]
    }
  },
